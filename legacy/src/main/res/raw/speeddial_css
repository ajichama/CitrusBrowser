/* 配色とタイルの寸法は既存設定へ任せ、形状・操作の見分けやすさだけを整える。 */
body {
    font-family: system-ui, Roboto, sans-serif;
}
.browserName {
    font-weight: 500;
    letter-spacing: .02em;
}
.search {
    box-sizing: border-box;
    width: calc(100% - 32px);
    margin: 20px 16px;
    padding: 14px 20px;
    border-radius: 28px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, .12);
}
.linkBox {
    padding-bottom: 16px;
}
.box {
    border-radius: 16px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, .12);
}
.box a {
    display: block;
    height: 100%;
    border-radius: inherit;
}
.box img {
    border-radius: 16px 16px 0 0;
}
#searchBox:focus-visible .search,
footer a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
}
.box a:focus-visible .name {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
}
/* 複数行のリンクや大きな文字でも、タイルへ重ならない通常フローにする。 */
footer {
    position: relative;
    box-sizing: border-box;
    width: 100%;
    height: auto;
    min-height: 48px;
    padding: 12px 12px 20px;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 4px;
}
footer a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    min-height: 40px;
    padding: 8px 12px;
    border: 1px solid currentColor;
    border-radius: 20px;
    line-height: 1.25;
    text-decoration: none;
}
footer a:hover {
    text-decoration: underline;
}
